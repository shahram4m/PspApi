                54 => ("LLLVAR", 120),
                60 => ("LLLVAR", 999),
                61 => ("LLLVAR", 999),
                62 => ("LLLVAR", 999),
                63 => ("LLLVAR", 999),
                90 => ("F", 42),
                92 => ("F", 2),
                95 => ("F", 42),
                100 => ("LLVAR", 11),
                128 => ("F", 16),
                _ => throw new Exception($"Field {fieldNum} not in dictionary")
            };
        }


        private static string byteToHex(byte[] bytes)
        {
            return BitConverter.ToString(bytes).Replace("-", "");
        }

        private static string BinaryToHex(string binary)
        {
            var hex = new StringBuilder(binary.Length / 4);
            for (int i = 0; i < binary.Length; i += 4)
                hex.Append(Convert.ToInt32(binary.Substring(i, 4), 2).ToString("X"));
            return hex.ToString();
        }

        private static string AsciiToHex(string ascii)
        {
            var hex = new StringBuilder(ascii.Length * 2);
            foreach (char c in ascii)
                hex.Append(((int)c).ToString("X2"));
            return hex.ToString();
        }
        public static void RunViaChannel()
        {
            Console.WriteLine("=== REAL SEND via ASCIIChannel ===\n");

            string host = "127.0.0.1";
            int port = 8583;
            int timeout = 30000;

            var packager = new SipaPackager();
            var msg = BuildIsoMsg(packager);

            string hexPreview = BuildHexFromIsoMsg(msg, includeTcpLength: true);
            Console.WriteLine("Message hex (after BuildIsoMsg):");
            Console.WriteLine(hexPreview);
            Console.WriteLine();
            var channel = new ASCIIChannel(host, port, packager);
            channel.setTimeout(timeout);

            try
            {
                Console.WriteLine("Connecting...");
                channel.connect();
                Console.WriteLine("Sending...");
                channel.send(msg);
                Console.WriteLine("Receiving...");
                ISOMsg response = channel.receive();

                Console.WriteLine("\nResponse received.");
                int max = response.getMaxField();
                for (int i = 0; i <= max; i++)
                {
                    if (response.hasField(i))
                    {
                        string val;
                        try { val = response.getString(i); }
                        catch { val = "<binary>"; }
                        Console.WriteLine($"Field {i,3}: {val}");
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("CHANNEL ERROR: " + ex.GetType().Name + ": " + ex.Message);
                Console.WriteLine(ex.StackTrace);
            }

            Console.WriteLine("\n=== Done ===");
        }

        private static byte[] HexToBytes(string hex)
        {
            if (hex.Length % 2 != 0)
                throw new ArgumentException("Invalid hex string");
            byte[] bytes = new byte[hex.Length / 2];
            for (int i = 0; i < bytes.Length; i++)
                bytes[i] = Convert.ToByte(hex.Substring(i * 2, 2), 16);
            return bytes;
        }
