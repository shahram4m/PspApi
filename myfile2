        private static string BuildHexFromIsoMsg(ISOMsg msg, bool includeTcpLength = true)
        {
            string mti;
            try { mti = msg.getMTI(); } catch { mti = "0200"; }
            if (string.IsNullOrEmpty(mti)) mti = "0200";

            int maxField = msg.getMaxField();
            bool useSecondary = maxField > 64;
            int bitmapBits = useSecondary ? 128 : 64;

            char[] bitmap = new char[bitmapBits];
            for (int i = 0; i < bitmapBits; i++) bitmap[i] = '0';
            if (useSecondary) bitmap[0] = '1';

            var de = new StringBuilder();

            for (int f = 1; f <= maxField; f++)
            {
                if (!msg.hasField(f)) continue;

                bitmap[f - 1] = '1';

                ISOComponent c = msg.getComponent(f);
                string value;
                if (c is ISOBinaryField bin)
                    value = ISOUtil.hexString(bin.getBytes());
                else
                    value = msg.getString(f);

                var (type, len) = GetFieldDef(f);

                switch (type)
                {
                    case "F":
                        if (value.Length != len) value = value.PadRight(len, ' ');
                        de.Append(value);
                        break;
                    case "LLVAR":
                    case "PAN":
                        de.Append(value.Length.ToString("D2")).Append(value);
                        break;
                    case "LLLVAR":
                        de.Append(value.Length.ToString("D3")).Append(value);
                        break;
                }
            }

            string bitmapHex = BinaryToHex(new string(bitmap));
            string body = mti + bitmapHex + de;

            if (includeTcpLength)
                body = body.Length.ToString("D4") + body;

            return AsciiToHex(body);
        }

