                33 => ("LLVAR", 11),
                35 => ("LLVAR", 37),
                37 => ("F", 12),
                38 => ("F", 6),
                39 => ("F", 2),
                41 => ("F", 8),
                42 => ("F", 16),
                43 => ("F", 40),
                48 => ("LLLVAR", 999),
                49 => ("F", 3),
