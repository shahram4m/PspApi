        private static string CalcDesCbc(byte[] data, string keyHex, bool isoPad80)
        {
            byte[] key = HexByte.HexToBytes(keyHex);
            int rem = data.Length % 8;
            byte[] padded;
            if (isoPad80)
            {
                padded = new byte[data.Length + (8 - rem)];
                Buffer.BlockCopy(data, 0, padded, 0, data.Length);
                padded[data.Length] = 0x80;
            }
            else
            {
                int pad = rem == 0 ? 0 : 8 - rem;
                padded = new byte[data.Length + pad];
                Buffer.BlockCopy(data, 0, padded, 0, data.Length);
            }

            using var des = DES.Create();
            des.Key = key;
            des.Mode = CipherMode.CBC;
            des.Padding = PaddingMode.None;
            des.IV = new byte[8];
            using var enc = des.CreateEncryptor();
            var res = enc.TransformFinalBlock(padded, 0, padded.Length);
            return HexByte.BytesToHex(res[^8..]);
        }

        private static string CalcXorDes(byte[] data, string keyHex)
        {
            byte[] key = HexByte.HexToBytes(keyHex);
            int pad = (data.Length % 8 == 0) ? 0 : 8 - (data.Length % 8);
            byte[] padded = new byte[data.Length + pad];
            Buffer.BlockCopy(data, 0, padded, 0, data.Length);

            byte[] xorBlock = new byte[8];
            for (int i = 0; i < padded.Length; i += 8)
                for (int j = 0; j < 8; j++)
                    xorBlock[j] ^= padded[i + j];

            using var des = DES.Create();
            des.Key = key;
            des.Mode = CipherMode.ECB;
            des.Padding = PaddingMode.None;
            using var enc = des.CreateEncryptor();
            var res = enc.TransformFinalBlock(xorBlock, 0, 8);
            return HexByte.BytesToHex(res);
        }



        public static byte[] CreatePinBlock(string pin, string pan, string pinKeyHex)
        {
            string pinPart = $"0{pin.Length}{pin}".PadRight(16, 'F');

            string panWithoutCheck = pan.Substring(0, pan.Length - 1);
            string pan12 = panWithoutCheck.Length >= 12
                ? panWithoutCheck.Substring(panWithoutCheck.Length - 12)
                : panWithoutCheck.PadLeft(12, '0');
            string panPart = "0000" + pan12;

            byte[] pinBytes = HexToBytes(pinPart);
            byte[] panBytes = HexToBytes(panPart);

            byte[] clear = new byte[8];
            for (int i = 0; i < 8; i++)
                clear[i] = (byte)(pinBytes[i] ^ panBytes[i]);

            byte[] key = HexToBytes(pinKeyHex);
            using var des = DES.Create();
            des.Key = key;
            des.Mode = CipherMode.ECB;
            des.Padding = PaddingMode.None;
            using var enc = des.CreateEncryptor();
            return enc.TransformFinalBlock(clear, 0, 8);
        }

        private static byte[] CalculateMac(byte[] message, string macKeyHex)
        {
            byte[] key = HexByte.HexToBytes(macKeyHex);

            using var des = DES.Create();
            des.Key = key;
            des.Mode = CipherMode.CBC;
            des.Padding = PaddingMode.None;
            des.IV = new byte[8];

            byte[] padded = PadToBlock(message, 8);

            using var encryptor = des.CreateEncryptor();
            var result = encryptor.TransformFinalBlock(padded, 0, padded.Length);

            return result[^8..];
        }
