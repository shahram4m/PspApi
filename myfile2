        public static string BuildField48Hex()
        {
            var ts = new TLVList();

            var tlvMsg = new TLVMsg((int)TLVTags.AddData, null, "AddData");

            var terminalInfo = new TLVMsg((int)TLVTags.TerminalInfo, null, "TerminalInfo");
            terminalInfo.AddChild(new TLVMsg(
                (int)TLVTags.AppVer,
                Encoding.ASCII.GetBytes("10.6.4.13"),
                "AppVer"));

            var misc = new TLVMsg((int)TLVTags.Miscellanies, null, "Miscellanies");
            misc.AddChild(new TLVMsg(
                (int)TLVTags.Language,
                Encoding.ASCII.GetBytes("00"),
                "Language"));

            var settlement = new TLVMsg((int)TLVTags.SettlementInfo, null, "SettlementInfo");
            settlement.AddChild(new TLVMsg(
                (int)TLVTags.CurrentBatchNo,
                Encoding.ASCII.GetBytes("1"),
                "CurrentBatchNo"));

            tlvMsg.AddChild(terminalInfo);
            tlvMsg.AddChild(misc);
            tlvMsg.AddChild(settlement);
            ts.append(tlvMsg);

            byte[] data48 = ts.pack();
            if (data48 == null || data48.Length == 0)
                throw new Exception("Field 48 pack returned empty.");

            return ISOUtil.hexString(data48);
        }

        private static string HexToAsciiString(string hex)
        {
            if (hex.Length % 2 != 0)
                throw new ArgumentException("Invalid hex string");
            var sb = new StringBuilder(hex.Length / 2);
            for (int i = 0; i < hex.Length; i += 2)
                sb.Append(Convert.ToChar(Convert.ToByte(hex.Substring(i, 2), 16)));
            return sb.ToString();
        }

        public static byte[] CalculateMAC(byte[] mpk, byte[] message)
        {
            DESCryptoServiceProvider provider = new DESCryptoServiceProvider
            {
                Padding = PaddingMode.Zeros
            };
            provider.Key = mpk;
            provider.IV = new byte[8];
            provider.Mode = CipherMode.CBC;
            byte[] sourceArray = provider.CreateEncryptor(mpk, new byte[8])
                .TransformFinalBlock(message, 0, message.Length);
            byte[] destinationArray = new byte[8];

            Array.Copy(sourceArray, sourceArray.Length - 8, destinationArray, 0, 8);
            return destinationArray;
        }

